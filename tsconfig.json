{
  "compilerOptions": {
    "target": "ES2015",        // 변환할 JavaScript 버전
    "module": "commonjs",      // 모듈 시스템 (e.g. commonjs, esnext)
    "outDir": "./dist",        // 컴파일된 파일 출력 폴더
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,      // 타입 정의 파일 검사 건너뛰기
    "jsx": "react"             // JSX 지원
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
